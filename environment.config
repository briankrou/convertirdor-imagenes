# Configuración del servidor
PORT=3000
HOST=0.0.0.0

# Configuración de desarrollo
VITE_DEV_PORT=5173
VITE_DEV_HOST=localhost

# Configuración de la aplicación
APP_NAME=Convertidor de Imágenes
APP_VERSION=1.0.0
APP_DESCRIPTION=Sistema de conversión de imágenes con IA

# Configuración de Gmail API
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Redirect URI para desarrollo local (debe usar HTTPS en producción)
GMAIL_REDIRECT_URI_DEV=http://localhost:3000/auth/callback
# Redirect URI fija para EasyPanel (HTTPS requerido) - NO MODIFICAR
GMAIL_REDIRECT_URI_PROD=https://dbkoko-convertidor-imagenes.mvitku.easypanel.host/auth/callback
# Redirect URI por defecto (se usa según el entorno)
GMAIL_REDIRECT_URI=https://dbkoko-convertidor-imagenes.mvitku.easypanel.host/auth/callback

# Configuración de base de datos
DB_PATH=./data/database.json

# Configuración de logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Configuración de seguridad
SESSION_SECRET=your-secret-key-here
JWT_SECRET=your-jwt-secret-here

# Configuración de CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
