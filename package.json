{
  "name": "convertidor-de-imagenes",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node simple-server.js",
    "dev": "node scripts/dev-server.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "node scripts/start-server.js",
    "start:env": "node -r dotenv/config simple-server.js",
    "start:vite": "vite preview --host 0.0.0.0 --port 3000",
    "dev:vite": "vite --host localhost --port 5173",
    "start:easypanel": "node scripts/easypanel-start.js",
    "start:proxy": "node scripts/easypanel-proxy.js",
    "config": "node scripts/config.js",
    "config:example": "node -e \"require('./scripts/config.js').generateEnvExample()\"",
    "env:check": "node -e \"const config = require('./scripts/config.js').loadEnvFile(); console.log('Variables cargadas:', Object.keys(config).length);\"",
    "docker:build": "docker build -t convertidor-imagenes .",
    "docker:run": "docker run -p 3000:3000 convertidor-imagenes"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "lowdb": "^7.0.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "http-proxy-middleware": "^3.0.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  },
  "keywords": [],
