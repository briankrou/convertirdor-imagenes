# Configuración para producción (EasyPanel)
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Configuración de la aplicación
APP_NAME=Convertidor de Imágenes
APP_VERSION=1.0.0
APP_DESCRIPTION=Sistema de conversión de imágenes con IA

# Configuración de base de datos
DB_PATH=/app/data/database.json

# Configuración de logging
LOG_LEVEL=info
LOG_FILE=/app/logs/app.log

# Configuración de seguridad
SESSION_SECRET=your-production-secret-key-here
JWT_SECRET=your-production-jwt-secret-here

# Configuración de CORS
CORS_ORIGIN=https://yourdomain.com
CORS_CREDENTIALS=true

# Configuración de Gmail API (configurar en EasyPanel)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://yourdomain.com/auth/callback
